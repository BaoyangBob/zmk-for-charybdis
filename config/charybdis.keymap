#include <dt-bindings/zmk/mouse.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1000 // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 12   // 10

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <0>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

/ {
    // 上下滚动编码器行为

    scroll_vertical_encoder: scroll_vertical_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    // 左右滚动编码器行为

    scroll_horizontal_encoder: scroll_horizontal_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

        tap-ms = <100>;
    };

    behaviors {
        // Home row mods - Left hand

        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 42 43 44 45 46 47 53 54 55>; // Right side keys
            hold-trigger-on-release;
        };

        // Home row mods - Right hand

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41 48 49 50 51 52>; // Left side keys
            hold-trigger-on-release;
        };

        // chain sticky key modifiers

        skq: sticky_key_quick_release {
            compatible = "zmk,behavior-sticky-key";
            #binding-cells = <1>;
            bindings = <&kp>;
            release-after-ms = <1000>;
            quick-release;
            ignore-modifiers;
        };

        // CAPSLOCK on a single tap, LSHIFT on a single press and hold, and LCTRL when the tap-dance is pressed twice

        td_mt: tap_dance_mod_tap {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mt LSHIFT CAPSLOCK>, <&kp LCTRL>;
        };
    };

    macros {
        // Ctrl+Alt+Cmd macro

        CAC: CAC {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&kp LCTRL &kp LALT &kp LGUI &macro_param_1to1>,
                <&macro_tap>,
                <&kp MACRO_PLACEHOLDER>,
                <&macro_release>,
                <&kp LCTRL &kp LALT &kp LGUI>;
        };

        // Ctrl+Shift+Alt macro

        CSA: CSA {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&kp LCTRL &kp LSHIFT &kp LALT &macro_param_1to1>,
                <&macro_tap>,
                <&kp MACRO_PLACEHOLDER>,
                <&macro_release>,
                <&kp LCTRL &kp LSHIFT &kp LALT>;
        };

        // Ctrl+Alt macro

        CA: CA {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&kp LCTRL &kp LALT &macro_param_1to1>,
                <&macro_tap>,
                <&kp MACRO_PLACEHOLDER>,
                <&macro_release>,
                <&kp LCTRL &kp LALT>;
        };

        // Hold Ctrl+Cmd+Left Click while key is pressed (for mouse drag window actions)

        ctrl_cmd_hold: ctrl_cmd_hold {
            compatible = "zmk,behavior-macro";
            wait-ms = <0>;
            tap-ms = <10>;
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL &kp LGUI &mkp LCLK>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&mkp LCLK &kp LCTRL &kp LGUI>;
        };
    };

    combos {
        compatible = "zmk,combos";
        timeout-ms = <20>;
        require-prior-idle-ms = <250>;

        // Studio Unlock Combo - all three right thumb keys

        combo_studio_unlock {
            timeout-ms = <50>;
            key-positions = <53 54 55>;
            bindings = <&studio_unlock>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
&kp ESC         &kp N1  &kp N2  &kp N3                      &kp N4              &kp N5      &kp N6              &kp N7                       &kp N8     &kp N9      &kp N0    &kp EQUAL
&kp TAB         &kp Q   &kp W   &kp E                       &kp R               &kp T       &kp Y               &kp U                        &kp I      &kp O       &kp P     &kp RIGHT_BRACKET
&kp LEFT_SHIFT  &kp A   &kp S   &kp D                       &kp F               &kp G       &kp H               &kp J                        &kp K      &kp L       &kp SEMI  &kp SQT
&kp LEFT_ALT    &kp Z   &kp X   &kp C                       &kp V               &kp B       &kp N               &kp M                        &kp COMMA  &kp PERIOD  &kp FSLH  &kp MINUS
                                &mt LEFT_CONTROL BACKSPACE  &lt 1 SPACE         &mkp MB1    &lt 1 SPACE         &mt RIGHT_CONTROL BACKSPACE
                                                            &mt LEFT_GUI ENTER  &mkp MB2    &mt LEFT_GUI ENTER
            >;

            sensor-bindings =
                <&scroll_vertical_encoder>,
                // 编码器1：上下滚动,,,,,,,,,,,
                <&scroll_horizontal_encoder>;

            // 编码器2：左右滚动
        };

        layer_1 {
            bindings = <
&kp F1         &kp F2        &kp F3               &kp F4              &kp F5        &kp F6          &kp F7          &kp F8          &kp F9        &kp F10    &kp F11               &kp F12
&kp LS(GRAVE)  &kp NUMBER_6  &kp NUMBER_7         &kp NUMBER_8        &kp NUMBER_9  &kp NUMBER_0    &none           &none           &none         &none      &kp LS(LEFT_BRACKET)  &kp LEFT_BRACKET
&kp CAPSLOCK   &none         &kp LS(PRINTSCREEN)  &kp LA(LC(DELETE))  &none         &kp GRAVE       &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT  &kp LS(BACKSLASH)     &kp LS(EQUAL)
&none          &none         &none                &mkp MB3            &mkp MB4      &mkp MB5        &none           &none           &none         &none      &kp BACKSLASH         &kp EQUAL
                                                  &none               &none         &none           &none           &kp DELETE
                                                                      &none         &none           &none
            >;
        };

        layer_2 {
            bindings = <
&trans               &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&kp LS(PRINTSCREEN)  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&kp LC(LA(DELETE))   &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans               &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                                     &trans  &trans  &trans    &trans  &trans
                                             &trans  &trans    &trans
            >;
        };

        pointer_layer {
            label = "POINTER";
            display-name = "Pointer";
            bindings = <
&kp GRAVE    &kp F1           &kp F2           &kp F3            &kp F4             &kp F5        &kp F6           &kp F7               &kp F8          &kp F9         &kp F10         &trans
&kp LA(TAB)  &kp LGUI         &kp LALT         &mo SNIPING       &mkp MB4           &mkp MB5      &kp HOME         &kp PG_DN            &kp PG_UP       &kp END        &kp F11         &kp F12
&kp RCTRL    &kp LG(A)        &ctrl_cmd_hold   &mkp RCLK         &mkp LCLK          &mkp MCLK     &kp LEFT         &kp DOWN             &kp UP          &kp RIGHT      &kp MINUS       &kp EQUAL
&kp LSFT     &hml LGUI LG(Z)  &hml LALT LG(X)  &hml LCTRL LG(C)  &hml LSHIFT LG(V)  &mo SCROLL    &kp RC(LS(TAB))  &hmr RSHIFT LC(TAB)  &hmr RCTRL INS  &hmr RALT INS  &hmr RGUI LBKT  &kp RBKT
                                               &trans            &trans             &trans        &trans           &trans
                                                                 &trans             &trans        &trans
            >;
        };

        lower_layer {
            label = "LOWER";
            display-name = "Lower";
            bindings = <
&kp ESC   &CAC F1  &CAC F2  &CAC F3  &CAC F4  &CAC F5    &CAC F6            &CAC F7        &CAC F8    &CAC F9  &CAC F10  &trans
&none     &CA Q    &CA W    &CA E    &CA R    &CA T      &CA Y              &CA U          &CA I      &CA O    &CAC F11  &CAC F12
&kp CAPS  &CA A    &CA S    &CA D    &CA F    &CA G      &CA H              &CA J          &CA K      &CA L    &CA SEMI  &CA SQT
&trans    &CA Z    &CA X    &CA C    &CA V    &CSA F1    &kp LS(LG(GRAVE))  &kp LG(GRAVE)  &CA COMMA  &CA DOT  &CA FSLH  &trans
                            &trans   &trans   &trans     &trans             &trans
                                     &trans   &trans     &trans
            >;
        };

        raise_layer {
            label = "RAISE";
            display-name = "Raise";
            bindings = <
&kp ESC  &kp F1  &kp F2      &kp F3        &kp F4         &kp F5           &kp F6        &kp F7          &kp F8        &kp F9        &kp F10  &trans
&trans   &trans  &CAC W      &kp C_VOL_UP  &kp LG(MINUS)  &kp LG(EQUAL)    &bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2  &bt BT_SEL 3  &kp F11  &kp F12
&trans   &none   &kp C_PREV  &kp C_PP      &kp C_NEXT     &kp LG(N0)       &kp F23       &kp F24         &none         &none         &none    &bootloader
&trans   &none   &none       &kp C_VOL_DN  &none          &none            &bt BT_CLR    &bt BT_CLR_ALL  &none         &none         &none    &none
                             &trans        &trans         &trans           &trans        &trans
                                           &trans         &trans           &trans
            >;
        };

        symbols_layer {
            label = "SYMBOLS";
            display-name = "Symbols";
            bindings = <
&kp GRAVE  &trans     &trans     &trans     &trans     &trans       &trans     &trans     &trans    &trans    &trans     &trans
&kp TILDE  &kp SQT    &kp LT     &kp GT     &kp DQT    &kp DOT      &kp COMMA  &kp AMPS   &kp LBKT  &kp RBKT  &kp PRCNT  &trans
&trans     &kp EXCL   &kp MINUS  &kp PLUS   &kp EQUAL  &kp UNDER    &kp PIPE   &kp COLON  &kp LPAR  &kp RPAR  &kp QMARK  &trans
&trans     &kp CARET  &kp FSLH   &kp ASTRK  &kp BSLH   &kp HASH     &kp TILDE  &kp DLLR   &kp LBRC  &kp RBRC  &kp AT     &trans
                                 &trans     &trans     &trans       &trans     &trans
                                            &trans     &trans       &trans
            >;
        };

        scroll_layer {
            label = "SCROLL";
            display-name = "Scroll";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans
                                &trans  &trans    &trans
            >;
        };

        sniping_layer {
            label = "SNIPING";
            display-name = "Sniping";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans
                                &trans  &trans    &trans
            >;
        };

        gaming_layer {
            label = "GAMING";
            display-name = "Gaming";
            bindings = <
&kp ESC  &kp N1     &kp N2  &kp N3  &kp N4  &kp N5       &kp N6  &kp N7  &kp N8     &kp N9   &kp N0    &kp DEL
&kp T    &kp TAB    &kp Q   &kp W   &kp E   &kp R        &kp Y   &kp U   &kp I      &kp O    &kp P     &kp BSLH
&kp G    &kp LSFT   &kp A   &kp S   &kp D   &kp F        &kp H   &kp J   &kp K      &kp L    &kp SEMI  &kp SQT
&kp B    &kp LCTRL  &kp Z   &kp X   &kp C   &kp V        &kp N   &kp M   &kp COMMA  &kp DOT  &kp FSLH  &kp RSFT
                            &trans  &trans  &kp SPACE    &trans  &trans
                                    &trans  &trans       &trans
            >;
        };
    };
};
