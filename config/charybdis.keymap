#include <dt-bindings/zmk/mouse.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1000 // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 12   // 10

&lt {
    tapping-term-ms = <200>;
    flavor = "tap-preferred";
    quick-tap-ms = <170>;
};

&mt {
    quick-tap-ms = <200>;
    flavor = "hold-preferred";
    tapping-term-ms = <300>;
};

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <0>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&sl { release-after-ms = <2000>; };

&sk { release-after-ms = <2000>; };

/ {
    // 上下滚动编码器行为

    scroll_vertical_encoder: scroll_vertical_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    // 左右滚动编码器行为

    scroll_horizontal_encoder: scroll_horizontal_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

        tap-ms = <100>;
    };

    behaviors {
        // Hold-tap behavior for layer with tap-preferred

        blt: blt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <300>;
            require-prior-idle-ms = <100>;
            bindings = <&mo>, <&kp>;
        };

        // Tap-dance for GUI/Ctrl+B

        gui_ctrlb: gui_ctrlb {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LGUI>, <&kp LC(B)>;
        };

        // Tap/hold Alt, double-tap Ctrl+Shift+Z

        lalt_dt: lalt_dt {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LALT>, <&kp LC(LS(Z))>;
        };

        // Home row mods - Left hand

        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <125>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&sk>, <&kp>;

            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 42 43 44 45 46 47 53 55 54 48 49 50 51 52>; // Right side keys
            hold-trigger-on-release;
        };

        // Home row mods - Right hand

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <125>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&sk>, <&kp>;

            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41 48 49 50 51 52 54 53 55>; // Left side keys
            hold-trigger-on-release;
        };

        // chain sticky key modifiers

        skq: sticky_key_quick_release {
            compatible = "zmk,behavior-sticky-key";
            #binding-cells = <1>;
            bindings = <&kp>;
            release-after-ms = <1000>;
            quick-release;
            ignore-modifiers;
        };

        // CAPSLOCK on a single tap, LSHIFT on a single press and hold, and LCTRL when the tap-dance is pressed twice

        td_cs: caps_shift_tap_dance {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LEFT_SHIFT>, <&double_shift>, <&kp CAPSLOCK>;
        };

        graesc: grave_escape {
            compatible = "zmk,behavior-mod-morph";
            label = "GRAVE_ESCAPE";
            bindings = <&kp ESCAPE>, <&kp GRAVE>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_LSFT|MOD_LALT|MOD_LGUI|MOD_RSFT|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
        };

        tap_key_hold_mouse: tap_kp_hold_mkp {
            compatible = "zmk,behavior-hold-tap";
            label = "tap key, hold mouse key";
            bindings = <&mkp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };

        mkp_mo: tap_mkp_hold_mo {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&sl>, <&mkp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
        };

        mkp_mkp: t_mkp_h_mkp {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&mkp>, <&mkp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
        };

        mt2: mod_tap_v2 {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <125>;
            flavor = "balanced";
            hold-trigger-on-release;
        };

        kp_sl: tap_kp_hold_sl {
            compatible = "zmk,behavior-hold-tap";
            label = "TAP_KP_HOLD_SL";
            bindings = <&sl>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            flavor = "balanced";
            quick-tap-ms = <175>;
            require-prior-idle-ms = <125>;
        };

        tap_gresc_hold_kp: tap_gresc_hold_kp {
            compatible = "zmk,behavior-hold-tap";
            label = "TAP_GRESC_HOLD_KP";
            bindings = <&kp>, <&gresc>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <125>;
            flavor = "balanced";
        };

        kp_sk: tap_kp_hold_sk {
            compatible = "zmk,behavior-hold-tap";
            label = "TAP_KP_HOLD_SK";
            bindings = <&sk>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            flavor = "balanced";
            quick-tap-ms = <175>;
            require-prior-idle-ms = <125>;
        };
    };

    macros {
        // Ctrl+Alt+Cmd macro

        CAC: CAC {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&kp LCTRL &kp LALT &kp LGUI &macro_param_1to1>,
                <&macro_tap>,
                <&kp MACRO_PLACEHOLDER>,
                <&macro_release>,
                <&kp LCTRL &kp LALT &kp LGUI>;
        };

        // Ctrl+Shift+Alt macro

        CSA: CSA {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&kp LCTRL &kp LSHIFT &kp LALT &macro_param_1to1>,
                <&macro_tap>,
                <&kp MACRO_PLACEHOLDER>,
                <&macro_release>,
                <&kp LCTRL &kp LSHIFT &kp LALT>;
        };

        // Ctrl+Alt macro

        CA: CA {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&kp LCTRL &kp LALT &macro_param_1to1>,
                <&macro_tap>,
                <&kp MACRO_PLACEHOLDER>,
                <&macro_release>,
                <&kp LCTRL &kp LALT>;
        };

        // Hold Ctrl+Cmd+Left Click while key is pressed (for mouse drag window actions)

        ctrl_cmd_hold: ctrl_cmd_hold {
            compatible = "zmk,behavior-macro";
            wait-ms = <0>;
            tap-ms = <10>;
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL &kp LGUI &mkp LCLK>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&mkp LCLK &kp LCTRL &kp LGUI>;
        };

        screen: screen {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp PRINTSCREEN>;
            label = "SCREEN";
        };

        lock: lock {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(LA(DELETE))>;
            label = "LOCK";
        };

        double_shift: double_shift {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT &kp LEFT_SHIFT>;
            label = "DOUBLE_SHIFT";
        };
    };

    combos {
        compatible = "zmk,combos";
        timeout-ms = <20>;
        require-prior-idle-ms = <250>;

        // Studio Unlock Combo - all three right thumb keys

        combo_studio_unlock {
            timeout-ms = <50>;
            key-positions = <53 54 55>;
            bindings = <&studio_unlock>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
&mt2 LS(GRAVE) ESCAPE              &mt2 LS(N1) N1     &mt2 LS(N2) N2     &mt2 LS(N3) N3               &mt2 LS(NUMBER_4) NUMBER_4  &mt2 LS(N5) N5      &mt2 LS(N6) N6             &mt2 LS(N7) N7      &mt2 LS(N8) N8        &mt2 LS(N9) N9           &mt2 LS(N0) N0                &mt2 LS(EQUAL) EQUAL
&mt2 GRAVE TAB                     &mt2 LEFT_ARROW Q  &mt2 DOWN_ARROW W  &mt2 UP_ARROW E              &mt2 RIGHT_ARROW R          &kp T               &kp Y                      &mt2 BACKSLASH U    &mt2 LS(BACKSLASH) I  &mt2 LS(LEFT_BRACKET) O  &mt2 LEFT_BRACKET P           &mt2 LS(RIGHT_BRACKET) RIGHT_BRACKET
&td_cs                             &hml LEFT_GUI A    &hml LEFT_ALT S    &hml LEFT_CONTROL D          &hml LEFT_SHIFT F           &mt2 ENTER G        &mt2 RS(SEMICOLON) H       &hmr RIGHT_SHIFT J  &hmr RIGHT_CONTROL K  &hmr RIGHT_ALT L         &hmr RS(RIGHT_GUI) SEMICOLON  &mt2 LS(SQT) SQT
&mt2 LS(PRINTSCREEN) LEFT_CONTROL  &kp Z              &kp X              &kp C                        &kp V                       &kp B               &mt2 INSERT N              &kp M               &mt2 LS(COMMA) COMMA  &mt2 LS(PERIOD) PERIOD   &mt2 LS(SLASH) SLASH          &mt2 LS(MINUS) MINUS
                                                                         &mt2 LEFT_CONTROL BACKSPACE  &kp_sl 1 SPACE              &mkp MB1            &mt2 LC(LA(DELETE)) SPACE  &kp BACKSPACE
                                                                                                      &kp ENTER                   &mkp_mkp MB2 MB3    &kp ENTER
            >;

            sensor-bindings =
                <&scroll_vertical_encoder>,
                // 编码器1：上下滚动,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,
                <&scroll_horizontal_encoder>;

            // 编码器2：左右滚动
        };

        layer_1 {
            bindings = <
&kp F1               &kp F2     &kp F3     &kp F4      &kp F5         &kp F6                &kp F7          &kp F8          &kp F9        &kp F10    &kp F11        &kp F12
&kp GRAVE            &kp LC(Q)  &kp LC(W)  &kp LC(E)   &kp LC(R)      &kp LC(T)             &none           &none           &none         &none      &none          &none
&kp CAPSLOCK         &kp LC(A)  &kp LC(S)  &kp LC(D)   &kp LC(F)      &kp LC(G)             &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT  &none          &none
&kp LS(PRINTSCREEN)  &kp LC(Z)  &kp LC(X)  &kp LC(C)   &kp LC(V)      &kp LC(B)             &kp LC(N)       &kp LC(M)       &none         &none      &kp LC(SLASH)  &none
                                           &kp DELETE  &none          &kp LA(LC(DELETE))    &none           &kp DELETE
                                                       &kp LC(ENTER)  &none                 &kp LC(ENTER)
            >;
        };
    };
};
